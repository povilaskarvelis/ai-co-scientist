# Vertex AI mode (recommended for hackathon deployment)
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"

# Cloud Run deploys require an existing Postgres DSN unless ephemeral state is explicitly allowed.
AI_CO_SCIENTIST_POSTGRES_DSN=""
AI_CO_SCIENTIST_SESSION_SECRET=""  # generated and stored on first deploy when unset

# Optional runtime tuning
ADK_NATIVE_MODEL="gemini-3.1-flash-lite-preview"
ADK_SYNTHESIZER_MODEL="gemini-2.5-pro"
ADK_ROUTER_MODEL="gemini-3.1-flash-lite-preview"
ADK_NATIVE_PLAN_MAX_ITERS="1"
ADK_NATIVE_EVIDENCE_MAX_ITERS="3"
ADK_NATIVE_PREFER_BIGQUERY="1"
ADK_MAX_RETAINED_CONVERSATIONS="6"  # idle conversation runtimes kept for fast follow-ups
ADK_MAX_RETAINED_COMPLETED_RUNS="200"  # completed/failed run records kept for polling history
ADK_MAX_RETAINED_REPORTS="100"  # generated report file groups kept on local disk
RATE_LIMIT_MAX_KEYS="10000"  # cap unique in-memory rate-limit identities
RATE_LIMIT_TRUSTED_PROXY_HOPS="0"  # deploy script sets this to 1 for Cloud Run

# Optional tool-source metadata
OPENALEX_MAILTO=""
CONTACT_EMAIL=""
HF_TOKEN=""
HF_DATASET_PUBMEDQA="qiaojin/PubMedQA"
HF_DATASET_BIOASQ="kroshan/BioASQ"
HF_DATASET_GPQA="Idavidrein/gpqa"
BIOGRID_ACCESS_KEY=""
BIOGRID_ORCS_ACCESS_KEY=""

# Optional BigQuery integration
BQ_PROJECT_ID="your-gcp-project-id"
BQ_LOCATION="US"
# Comma-separated allowlist, e.g. "your-gcp-project-id.shared_dataset"
BQ_DATASET_ALLOWLIST=""
# Cost guardrail (bytes billed per query)
BQ_MAX_BYTES_BILLED="5000000000"
